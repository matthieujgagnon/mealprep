# Copy this file to server/.env and fill in what you need. Every variable the
# server reads is listed here, with an empty value. Empty means "not set":
# the server then uses its built-in default, or turns that feature off.

# Postgres connection string (Neon, or a local database). Required.
DATABASE_URL=

# Port the server listens on (default 4000).
PORT=

# "production" makes the login cookie HTTPS-only. Render sets this for you.
NODE_ENV=

# Public address of the app, used for links in "forgot password" emails
# (default http://localhost:5173).
APP_URL=

# Long random password that lets the weekly GitHub Action trigger the flyer
# import. Without it the import endpoint answers 503.
CRON_SECRET=

# Google Gemini key, for flyer-deal extraction and receipt import.
GEMINI_API_KEY=

# Resend key and sender address, for "forgot password" emails. Without a key
# the email is not sent.
RESEND_API_KEY=
RESET_EMAIL_FROM=

# Set to "off" to turn off the app's own hourly flyer auto-import.
FLYER_AUTO_IMPORT=

# Overrides for the flyer and price data sources (leave empty for the defaults).
FLIPP_BASE_URL=
STATCAN_WDS_URL=
