generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person who can log into the app. Each user's recipes/planner/grocery
// list/flyer deals are entirely their own — no data is shared between
// accounts (see the userId field on every other model below).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  locale       String? // "fr" | "en": the app's language for this account (and its emails); null until first chosen
  weekendDays  Int[]    @default([5, 6]) // the days the Planner groups as the weekend (0 = Monday ... 6 = Sunday)
  weekendOn    Boolean  @default(true) // whether the Planner draws the weekend block at all
  weekendEve   Boolean  @default(true) // whether the block also takes in the supper before its first day
  createdAt    DateTime @default(now())

  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  recipes               Recipe[]
  recipeCategories      RecipeCategory[]
  pantryStaples         PantryStaple[]
  grocerySections       GrocerySection[]
  groceryAssignments    GroceryAssignment[]
  groceryCheckedItems   GroceryCheckedItem[]
  groceryExtraItems     GroceryExtraItem[]
  groceryItemOverrides  GroceryItemOverride[]
  inventorySections     InventorySectionLayout[]
  flyerDeals            FlyerDeal[]
  flyerUploads          FlyerUpload[]
  plannerEntries        PlannerEntry[]
  pantryInventoryItems  PantryInventoryItem[]
  pantryConsumptionLogs PantryConsumptionLog[]
  pantryLocations       PantryLocation[]
  watchlistItems        WatchlistItem[]
  recipeImages          RecipeImage[]
  flyerSettings         FlyerSettings?
}

// A logged-in session, looked up by the id stored in the browser's httpOnly
// session cookie - the cookie holds nothing but this row's id (a cuid, long
// and unguessable enough to serve as the bearer token itself), so a stolen
// cookie only works until expiresAt and can be revoked by deleting the row.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A one-time link mailed to a "forgot password" request - id itself is the
// unguessable token (same bearer-token approach as Session above), short-
// lived and consumed on use so it can't be replayed. Old/expired rows are
// harmless clutter, not a security concern, so nothing prunes them.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Recipe {
  id              String          @id @default(cuid())
  userId          String? // nullable only for the brief window before the first account claims pre-existing (single-user-era) rows - see auth.js's signup backfill. Every row is owned after that.
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  sourceUrl       String?
  photoUrl        String?
  photos          String          @default("[]") // JSON-stringified array of all image URLs found at import
  notes           String? // freeform recipe-level notes ("used less salt", "great with rice") — separate from any per-ingredient note
  inCookbook      Boolean         @default(false) // true for manual entries, or imported recipes dragged into the cookbook
  inImported      Boolean         @default(true) // true for recipes that came from a URL import; independent of inCookbook so deleting from one section doesn't affect the other
  isPlaceholder   Boolean         @default(false) // true for the generic "Restaurant"/"YOLO"/"N/A" planner cards, which aren't real recipes
  baseServings    Int             @default(4)
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  fridgeLifeDays  Int? // how many days this keeps well as a fridge leftover; user-set, powers the "past its fridge life" warning on leftover-marked planner cards
  instructions    String // JSON-stringified array of step strings
  tags            String          @default("[]") // JSON-stringified array of tag strings, e.g. ["shrimp","summer"]
  mealSlot        String? // where it sits on the Planner: "breakfast" | "lunch" | "dinner" | "snack" (any slot) | "prep" (pantry/prep - no calendar slot); null = not set yet
  categoryId      String? // user-created cookbook category, e.g. "Breakfast", "Sides"; null = uncategorized
  category        RecipeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  position        Int             @default(0) // manual drag-to-reorder position within whichever grid (Imported / Cookbook / a category) it's shown in
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  ingredients    Ingredient[]
  plannerEntries PlannerEntry[]

  @@index([userId])
}

model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity Float? // base quantity for recipe.baseServings; null for "to taste" items
  unit     String? // e.g. "g", "cup", "tbsp"; null when quantity is unitless (e.g. "2 eggs")
  notes    String? // prep note kept separate from the name, e.g. "melted", "diced" — shown alongside the ingredient but excluded from grocery-list name matching
  group    String? // section header this ingredient falls under, e.g. "For the sauce"; null if the recipe has no sub-groups
  position Int     @default(0)
}

// A user-created cookbook category, e.g. "Breakfast", "Sides", "Mains" — for
// organizing recipes within "My Cookbook". Mirrors GrocerySection, but lives
// as a direct field on Recipe (categoryId) rather than a separate
// assignment table, since a recipe already has its own stable id/record to
// attach it to — unlike a grocery item, which is just a computed string.
model RecipeCategory {
  id        String   @id @default(cuid())
  userId    String? // nullable only pre-backfill - see Recipe.userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  recipes   Recipe[]

  // Real unique constraint (added via a real migration, not `db push` -
  // see the migrations/ folder) so "one name per account" is actually
  // enforced, not just attempted in application code.
  @@unique([userId, name])
}

// A canonical ingredient name (e.g. "salt", "olive oil") with a user
// decision about staple status, overriding the app's built-in default list
// (STAPLE_WORDS/SPICE_WORDS on the client) either direction:
//   - excluded: false (default) - explicitly marked a staple, e.g. dragged
//     onto the "staples" section of the grocery list.
//   - excluded: true - explicitly marked NOT a staple, even though it's on
//     the built-in default list (e.g. "salt") — otherwise there'd be no way
//     to ever remove one of those from the staples section, since they
//     aren't backed by a row at all until the user overrides them.
// No row at all = defer entirely to the built-in default list.
model PantryStaple {
  id        String   @id @default(cuid())
  userId    String? // nullable only pre-backfill - see Recipe.userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  core      String // normalized ingredient name, e.g. "olive oil"
  category  String? // "spice" | "other" — user override of the automatic spice/other split; null = auto-detect
  excluded  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Real unique constraint - see RecipeCategory's @@unique comment above.
  @@unique([userId, core])
}

// A user-created grocery list section, e.g. "Metro", "Super C", "Fruit du Jour"
model GrocerySection {
  id          String              @id @default(cuid())
  userId      String? // nullable only pre-backfill - see Recipe.userId
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  position    Int                 @default(0)
  createdAt   DateTime            @default(now())
  assignments GroceryAssignment[]

  // Real unique constraint - see RecipeCategory's @@unique comment above.
  @@unique([userId, name])
}

// Maps a canonical ingredient name to a grocery section the user dragged it into
model GroceryAssignment {
  id        String         @id @default(cuid())
  userId    String? // nullable only pre-backfill - see Recipe.userId
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  core      String // normalized ingredient name, e.g. "avocado"
  sectionId String
  section   GrocerySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  // Real unique constraint - see RecipeCategory's @@unique comment above.
  @@unique([userId, core])
}

// A checked-off grocery item. Existence of a row = checked; unchecking
// deletes it. The grocery list is one persistent list (every planned meal
// from today on), so a check stays until you uncheck it. Previously lived
// in the browser's localStorage (per-device only), which meant checking
// something off on one phone didn't show up on another - this table is what
// makes the list actually sync.
model GroceryCheckedItem {
  id          String   @id @default(cuid())
  userId      String? // nullable only pre-backfill - see Recipe.userId
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  core        String // normalized ingredient name, matches the grocery list's item.key
  // What the check covers: the amount the row showed when it was checked, as
  // { parts: [{ quantity, unit }], usedIn: [recipe titles] }. A meal added
  // later that needs more leaves the extra unchecked. Null on a check made
  // before amounts were saved: it covers whatever the row needs, until the
  // list saves the amount (see tidyChecks in the client's groceryChecks.js).
  covered     Json?
  // What "Done shopping" has already put in Inventory, same shape. Those
  // amounts are off the list; the row stays only to remember them, until no
  // planned meal needs the item any more.
  bought      Json?
  // Before amounts were saved, "Done shopping" set this and left the row
  // checked. Kept for those rows: true with no `bought` means everything the
  // row needed was bought. New rows leave it false.
  inInventory Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Real unique constraint - see RecipeCategory's @@unique comment above.
  @@unique([userId, core])
}

// A manually-typed grocery item, on top of whatever the planner's recipes
// already generate (e.g. "paper towels", or extra onions beyond what a
// recipe calls for). Kept as its own line rather than merged into a
// recipe-derived row's quantity - see groceryList.js's buildGroceryList - so
// adding/removing one never touches what a recipe contributes. Existence of
// a row = it's on the list; deleting it removes just that one line.
model GroceryExtraItem {
  id        String   @id @default(cuid())
  userId    String? // nullable only pre-backfill - see Recipe.userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  quantity  Float?
  unit      String?
  dealId    String? // the flyer deal it was added from (Flyers -> add to list); tapping the row opens that deal. Null for an item typed by hand or added from a recipe.
  createdAt DateTime @default(now())

  @@index([userId])
}

// Changes to one grocery list row (keyed by the row's key - the ingredient
// core for recipe rows, "extra-<id>" for hand-added ones): `removed` takes a
// recipe-derived row off the list until the meals that need it leave the
// plan (the client clears the row then), and `quantity` is your own amount
// ("2 packs"), shown next to what the recipes call for. Recipe amounts
// themselves are never changed.
model GroceryItemOverride {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  quantity  String?
  removed   Boolean  @default(false)
  // A removed row cleared from the "Removed" strip.
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// A single deal extracted from an uploaded flyer PDF or photo via Gemini,
// replacing the old hardcoded MOCK_DEALS array. Re-uploading under the same
// source replaces that source's rows outright, since a new upload
// supersedes the old one rather than adding to it.
model FlyerDeal {
  id         String   @id @default(cuid())
  userId     String? // nullable only pre-backfill - see Recipe.userId
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      String // the actual store this item's price is from (e.g. "Metro") - extracted per-item for a multi-store roundup image, or just the upload's source for a normal single-store flyer
  source     String? // identifies the flyer/upload this deal came from - the name typed on upload (e.g. "Metro"), or "Flipp" for the weekly import; re-uploading with the same source supersedes its previous deals (see isCurrent below), independent of the per-item store above. Null for rows from before this field existed - falls back to store for those.
  category   String // "protein" | "produce" | "dairy" | "bakery" | "staple" | "other"
  item       String // displayed exactly as printed on the flyer, in whatever language that is
  matchName  String? // item translated to plain English grocery terms (e.g. "brocoli" -> "broccoli"), for matching against recipe ingredient names; null for rows from before this field existed, or when extraction didn't provide one — falls back to item
  price      String // display string as printed on the flyer, e.g. "$4.99/lb"
  unitPrice  Float? // price/quantity reduced to a single number in unitBasis's unit (e.g. "2 for $5" -> 2.5, "900g for $1.99" -> converted to price per lb) — null when extraction couldn't confidently reduce the printed price to one comparable number
  unitBasis  String? // "lb" | "each" | "L" — the unit unitPrice is expressed in, so deals are only ever compared within the same basis; null alongside a null unitPrice
  validUntil String? // "YYYY-MM-DD" flyer end date, if printed; null if not stated
  regularPrice Float? // the usual price the flyer itself states ("Save $2.00", "Reg. $6.99"), in the same unit as unitPrice - null when it doesn't say
  imageUrl   String? // this item's own photo on the flyer, when the source provides one per item (the Flipp import) — null for manually-uploaded flyers, which show the whole uploaded page instead (see FlyerUpload)
  isCurrent  Boolean  @default(true) // true = still on the active flyer for its source; a re-upload/re-import under the same source flips its previous rows to false instead of deleting them, so price history accumulates over time rather than being wiped every week. GET /api/deals (and anything showing "what's on sale now") filters to isCurrent: true; a superseded row is kept only so later price-history features (6-month low/high, "is this a real deal") have real data to compare against.
  createdAt  DateTime @default(now())

  @@index([userId, store])
  @@index([userId, source])
  @@index([userId, isCurrent])
  @@index([userId, matchName])
}

// A flyer ingredient the user wants to keep an eye on, from the Riso Poster
// Flyers redesign's ★ toggle - keyed by matchName (lowercase, same matching
// text FlyerDeal.matchName uses) rather than a specific FlyerDeal row, so a
// watch survives past whichever week's deal it was toggled from and matches
// any store/source that later lists the same ingredient.
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchName String
  createdAt DateTime @default(now())

  @@unique([userId, matchName])
}

// The raw file behind a manually-uploaded flyer (see POST /api/flyers/upload)
// kept around so its page can be viewed later, not just its extracted deals -
// stored as-is (PDF or photo) and served back verbatim so the browser's own
// PDF/image viewer renders it, rather than this app re-rendering pages itself.
// One row per (userId, source): a re-upload under the same source name
// replaces it, same as FlyerDeal's own replace-on-reupload behavior.
model FlyerUpload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([userId, source])
}

// A specific item physically in the user's fridge/pantry/freezer right now -
// distinct from PantryStaple (which is just a grocery-list categorization
// flag, not a real inventory) and from the planner's alreadyHave flag (a
// quick per-meal override) - see the schema comment history in this repo's
// PR discussion for why those two stay separate. Existence of a row = it's
// in stock; deleting it (or letting it expire) means it's not.
model PantryInventoryItem {
  id          String    @id @default(cuid())
  userId      String? // nullable only pre-backfill - see Recipe.userId
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String // as typed, e.g. "chicken breast"
  core        String // lowercased name, for lookups; not run through groceryList.js's fuller canonicalize() since nothing here needs recipe-ingredient-level normalization
  category    String    @default("other") // one of foodkeeper.js's CATEGORIES - auto-suggested from the same FoodKeeper product match the expiration date comes from, editable like any other field
  quantity    Float?
  unit        String?
  location    String    @default("fridge") // "pantry" | "fridge" | "freezer" - which USDA FoodKeeper column the expiration suggestion was drawn from
  purchasedAt DateTime  @default(now())
  expiresAt   DateTime? // suggested from the bundled USDA FoodKeeper data at add-time, or set/edited by the user - null means no suggestion was available and none was typed in
  imageUrl    String? // the item's photo on its Inventory card: an upload (/api/recipe-images/...) or a link; null shows a food emoji instead
  createdAt   DateTime  @default(now())

  // Unlike RecipeCategory/PantryStaple/etc., this one is genuinely meant to
  // be multi-row per (userId, core) - buying milk twice is two separate
  // inventory rows with different purchase/expiry dates, not one row to
  // merge into. Plain index, not a unique-constraint candidate.
  @@index([userId, core])
}

// A recipe card placed on a specific day of a specific week's planner.
// weekStart is the Monday of that week, "YYYY-MM-DD" — a plain calendar-date
// string rather than a DateTime, so there's no timezone conversion to get
// wrong when comparing it to a day picked in the browser. The default below
// is push-safe: `prisma db push` can add a required column with a static
// default with no prompt or data loss, unlike a schema-level default that
// referenced another table's id (which can't exist yet for old rows). Every
// pre-existing PlannerEntry (the old single permanent template) lands on
// this one week, which becomes its first real week once this ships.
model PlannerEntry {
  id          String   @id @default(cuid())
  userId      String? // nullable only pre-backfill - see Recipe.userId
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   String   @default("2026-08-31")
  dayOfWeek   Int // 0 = Monday ... 6 = Sunday
  mealType    String   @default("dinner") // "breakfast" | "lunch" | "dinner"
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  servings    Int? // override servings for this planned meal; falls back to recipe.baseServings
  isLeftover  Boolean  @default(false) // true = reusing food from another planned meal; excluded from grocery list
  alreadyHave Boolean  @default(false) // true = already have what this meal needs on hand (e.g. breakfast staples); excluded from grocery list, same as a leftover, but for a different reason
  position    Int      @default(0) // order within the day+mealType slot
  createdAt   DateTime @default(now())

  @@index([userId, weekStart])
}

// A record that a PantryInventoryItem was removed via the Inventory page's
// "Used up" or "Tossed" bulk action (see routes/pantryInventory.js's POST
// /consume) - snapshotted at removal time (name/core/category) rather than
// a foreign key to the item, since the item itself is hard-deleted, not
// soft-deleted. Nothing reads this yet - no waste report exists in this
// app - but it exists so that report has real history to work from later
// instead of starting from zero the day it ships.
model PantryConsumptionLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  core      String
  category  String?
  action    String // "consumed" | "wasted"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A user-added storage place beyond the three built-in ones (Fridge,
// Pantry, Freezer, which stay hardcoded since they're also the three USDA
// FoodKeeper shelf-life columns - see foodkeeper.js). A custom section has
// no USDA data of its own: items placed in one just don't get a
// freshness bar or a suggested expiry, same as any item whose name didn't
// match the USDA dataset at all. PantryInventoryItem.location stores
// either a built-in id ("fridge"/"pantry"/"freezer") or one of these rows'
// own id - looked up by id (not name) so renaming a section doesn't strand
// the items already placed in it.
// How the Inventory page lays out its sections - the built-in
// fridge/freezer/pantry ones and custom PantryLocations alike, keyed by the
// same id items store in `location`. `label` renames a built-in section
// (custom ones rename through PantryLocation.name); `size` is its width in
// columns of the 6-column grid ("1"-"6"; older rows say "third", "half" or
// "full") and `height` its height in px (null = fits its items). Sections
// without a row use the defaults.
model InventorySectionLayout {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionId String
  label     String?
  position  Int     @default(0)
  size      String  @default("half")
  height    Int?

  @@unique([userId, sectionId])
}

model PantryLocation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  // Real unique constraint - see RecipeCategory's @@unique comment above.
  @@unique([userId, name])
}

// A photo uploaded from the recipe editor (dropped or picked from disk),
// stored as-is and served back at /api/recipe-images/:id - Recipe.photos
// stores that path like any other photo URL.
model RecipeImage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId])
}

// Where and what to import flyers from automatically (Flyers tab ->
// Auto-import), plus how the last run went. One row per account; an
// account without a row never auto-imports.
model FlyerSettings {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postalCode        String    @default("H2T2S3")
  stores            String    @default("[\"Metro\",\"IGA\",\"Maxi\",\"Super C\",\"Provigo\"]") // JSON array of store names as the user picked them
  autoImport        Boolean   @default(true)
  lastImportAt      DateTime? // when the last run finished, successful or not
  lastImportOk      Boolean?
  lastImportCount   Int? // deals written by the last run
  lastImportSource  String? // "Flipp"
  lastImportMessage String? // a short note for the Flyers screen, e.g. which store's flyer couldn't be read
  lastSuccessAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Quebec's average price for one product, from Statistics Canada's monthly
// retail price table (see lib/statcan.js) - the same for every account, so
// no userId. Refreshed about weekly; StatCan publishes monthly.
model PriceBaseline {
  id        String   @id @default(cuid())
  product   String   @unique // StatCan's own name, e.g. "Chicken breasts, per kilogram"
  productFr String? // and its French name, e.g. "Poitrines de poulet, par kilogramme"
  item      String // the part before the comma, lowercase: what deals are matched on
  unitBasis String // "lb" | "L" | "each", same bases as FlyerDeal.unitBasis
  price     Float // latest month, converted to unitBasis
  month     String // "YYYY-MM" of that latest price
  history   String   @default("[]") // JSON [{ month, price }] oldest first, up to 12 months
  updatedAt DateTime @updatedAt
}
